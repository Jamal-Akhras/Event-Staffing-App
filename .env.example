# Local development configuration.
# Do not use these values in production.

ENVIRONMENT=development

POSTGRES_DB=event_staffing
POSTGRES_USER=event_staffing
POSTGRES_PASSWORD=event_staffing_local_password
POSTGRES_PORT=5433
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://event_staffing:event_staffing_local_password@localhost:5433/event_staffing
# SQLite fallback for quick demos/tests without Docker:
# DATABASE_URL=sqlite+pysqlite:///./event_staffing.db

# Force in-memory repositories (overrides DATABASE_URL).
# Also forces in-memory rate-limit store and token denylist (no Redis needed).
USE_IN_MEMORY=false

# Redis — shared store for rate limiting and JWT revocation.
# In development, leave blank to use the in-memory fallback (logs a warning).
# Outside development the app refuses to start if REDIS_URL is unset.
REDIS_URL=redis://localhost:6379/0

# Trust the X-Forwarded-For header for the real client IP.
# Enable ONLY when running behind a known proxy/load balancer that sets it.
# When false (default), the socket peer IP is used, which is spoofing-safe.
TRUST_FORWARDED_FOR=false

# When true, allows using X-Actor-Role header instead of JWT authentication
# NEVER set to true in production
DEV_MODE=true
JWT_SECRET_KEY=local-dev-secret-change-before-production
JWT_EXPIRATION_HOURS=24

# Operator sign-up gate. Comma-separated invite codes; an operator must supply one.
OPERATOR_INVITE_CODES=dev-operator-invite

# Email delivery for verification links.
# EMAIL_TRANSPORT=logging (default in dev) logs the link instead of sending.
# EMAIL_TRANSPORT=smtp sends via the SMTP_* settings below.
EMAIL_TRANSPORT=logging
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Base URL the verification link points at (the web app).
WEB_BASE_URL=http://localhost:5173

API_HOST=127.0.0.1
API_PORT=8001
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE=http://127.0.0.1:8001
EXPO_PUBLIC_API_BASE=http://192.168.10.131:8001

# Optional: leave blank locally. Errors are reported when DSN is set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
