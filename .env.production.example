ENVIRONMENT=production
DEV_MODE=false

# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<replace>

# Managed Postgres connection string.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/event_staffing

# Managed Redis — REQUIRED in production. The app refuses to start without it.
# Used for the shared rate-limit store and JWT revocation denylist.
REDIS_URL=redis://HOST:6379/0

# Enable only when running behind a proxy/load balancer that sets X-Forwarded-For
# (Render, most cloud LBs do). Required for correct per-client rate limiting.
TRUST_FORWARDED_FOR=true

CORS_ORIGINS=https://your-web-app.example.com

# S3-compatible durable object storage (Cloudflare R2 recommended).
STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=<replace>
OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=<replace>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<replace>
OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.your-domain.example.com

# Operator sign-up gate. Comma-separated invite codes. Keep these secret.
OPERATOR_INVITE_CODES=<replace-with-one-or-more-codes>

# Email delivery — verification links are sent via SMTP in production.
EMAIL_TRANSPORT=smtp
SMTP_HOST=<replace>
SMTP_PORT=587
SMTP_USER=<replace>
SMTP_PASSWORD=<replace>
SMTP_FROM=no-reply@your-domain.example.com
# Base URL the verification link points at (your deployed web app).
WEB_BASE_URL=https://your-web-app.example.com
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Phase 2 (payments) — placeholders, not yet consumed by the code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry — set both DSNs to capture API and web errors. Leave blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Google / Apple sign-in via Clerk (production instance keys).
CLERK_ISSUER=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=
VITE_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
