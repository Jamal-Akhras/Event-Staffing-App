# Lightweight local fallback without Docker/Postgres.
# Prefer `.env.example` for the Postgres-backed default dev setup.

DATABASE_URL=sqlite+pysqlite:///./event_staffing.db
USE_IN_MEMORY=false

DEV_MODE=true
JWT_SECRET_KEY=local-dev-secret-change-before-production
JWT_EXPIRATION_HOURS=24

API_HOST=127.0.0.1
API_PORT=8001
WEB_PORT=5173
VITE_API_BASE=http://127.0.0.1:8001
EXPO_PUBLIC_API_BASE=http://192.168.10.131:8001
